{
  "name": "telegram-deal-watcher",
  "version": "0.1.0",
  "description": "Monitora canais de promoções no Telegram e avisa quando aparece uma palavra-chave.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "login": "tsx src/login.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  }
}
