# Copie para .env e preencha. O .env nunca vai para o git.

# https://my.telegram.org > API development tools
API_ID=
API_HASH=

# Gerado com: npm run login
TELEGRAM_SESSION=

# Bot que envia os avisos, criado no @BotFather
BOT_TOKEN=
# Seu id no Telegram (descubra com o @userinfobot)
NOTIFY_CHAT_ID=

# Segundos entre cada verificação dos canais (mínimo 20)
POLL_INTERVAL_SECONDS=60
